{
	"info": {
		"_postman_id": "8f3b4c10-91a2-4d5e-b873-123456789abc",
		"name": "Social Media API Collection (Auth, Account Lifecycle & Profile)",
		"description": "Complete Postman Collection for testing Spring Boot Instagram-style Backend including OTP Registration, Login, JWT Cookies & Bearer Tokens, Account Lifecycle (Deactivation, Reactivation, Scheduled Deletion, Permanent Cascade Deletion), and Profile Management (JSON Create/Update, Cloudinary File Avatar Upload).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "testEmail",
			"value": "testuser@example.com",
			"type": "string"
		},
		{
			"key": "testPassword",
			"value": "Password123!",
			"type": "string"
		},
		{
			"key": "newPassword",
			"value": "NewPassword123!",
			"type": "string"
		},
		{
			"key": "otpCode",
			"value": "123456",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "profileUsername",
			"value": "mohankumar",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "health"]
						},
						"description": "Checks if the backend authentication server is running."
					},
					"response": []
				},
				{
					"name": "1.2 Register User (JSON Only)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Mohan Kumar\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Registers a new user account with JSON only and sends a 6-digit OTP code to their email."
					},
					"response": []
				},
				{
					"name": "1.3 Request / Resend OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/otp/request",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "otp", "request"]
						},
						"description": "Requests a new OTP email for the specified email address."
					},
					"response": []
				},
				{
					"name": "1.4 Verify OTP & Authenticate",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"}",
									"if (jsonData.refreshToken) {",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"{{otpCode}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/otp/verify",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "otp", "verify"]
						},
						"description": "Validates the OTP code, marks email verified, sets cookies, and stores JWT accessToken in variables."
					},
					"response": []
				},
				{
					"name": "1.5 User Login (Auto-Reactivates Deactivated Account)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"}",
									"if (jsonData.refreshToken) {",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Authenticates user with JSON. If account was DEACTIVATED or PENDING_DELETION (within 30 days), logging in automatically restores it to ACTIVE."
					},
					"response": []
				},
				{
					"name": "1.6 Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"}",
									"if (jsonData.refreshToken) {",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Exchanges a valid refresh token for a new access token and refresh token."
					},
					"response": []
				},
				{
					"name": "1.7 Forgot Password (Request OTP)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "forgot-password"]
						},
						"description": "Triggers a password reset 6-digit OTP to the user's email."
					},
					"response": []
				},
				{
					"name": "1.8 Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{otpCode}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "reset-password"]
						},
						"description": "Verifies the reset OTP code and updates the user password."
					},
					"response": []
				},
				{
					"name": "1.9 User Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.collectionVariables.set('accessToken', '');",
									"pm.collectionVariables.set('refreshToken', '');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Revokes active refresh tokens in database and clears session cookies."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Account Lifecycle (Instagram Style)",
			"item": [
				{
					"name": "2.1 Get Current User Account & Status (/users/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "me"]
						},
						"description": "Returns current account details including id, email, fullName, accountStatus (ACTIVE, DEACTIVATED, PENDING_DELETION, DELETED, SUSPENDED), deactivatedAt, and scheduledDeletionAt."
					},
					"response": []
				},
				{
					"name": "2.2 Deactivate Account (/users/me/deactivate)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me/deactivate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "me", "deactivate"]
						},
						"description": "Temporarily deactivates the account. Sets accountStatus = DEACTIVATED and deactivatedAt timestamp. Revokes tokens, clears cookies. Profile is hidden from public view until reactivated."
					},
					"response": []
				},
				{
					"name": "2.3 Reactivate Account (/users/me/reactivate)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me/reactivate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "me", "reactivate"]
						},
						"description": "Manually reactivates an account. Sets accountStatus = ACTIVE and clears deactivatedAt. (Note: standard login also automatically reactivates the account)."
					},
					"response": []
				},
				{
					"name": "2.4 Schedule Account Deletion (/users/me/schedule-deletion)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me/schedule-deletion",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "me", "schedule-deletion"]
						},
						"description": "Instagram-style pending deletion. Sets accountStatus = PENDING_DELETION and scheduledDeletionAt to 30 days in the future. Logging back in during the 30-day window cancels deletion."
					},
					"response": []
				},
				{
					"name": "2.5 Permanently Delete Account Immediately (/users/me/permanent)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me/permanent",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "me", "permanent"]
						},
						"description": "Hard deletes the entire account immediately! Removes Cloudinary avatar, deletes user record, and cascades deletion to profile, tokens, OTPs, and all user data."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Profile Management (Pure JSON & File Upload)",
			"item": [
				{
					"name": "3.1 Create Profile (Pure JSON Only)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{profileUsername}}\",\n  \"displayName\": \"Mohan Kumar\",\n  \"bio\": \"Software Engineer | Cloud & Full-Stack Developer building scalable web architectures.\",\n  \"dateOfBirth\": \"2000-01-15\",\n  \"gender\": \"MALE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/profiles",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "profiles"]
						},
						"description": "Creates a new public profile for the authenticated user using pure JSON only. Avatar image is uploaded separately via File upload."
					},
					"response": []
				},
				{
					"name": "3.2 Get Current User Profile (/profiles/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/profiles/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "profiles", "me"]
						},
						"description": "Fetches the full profile details of the currently authenticated user."
					},
					"response": []
				},
				{
					"name": "3.3 Get Public Profile by Username",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/profiles/{{profileUsername}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "profiles", "{{profileUsername}}"]
						},
						"description": "Fetches a user's public profile by unique username. If the user's account is DEACTIVATED, SUSPENDED, or PENDING_DELETION, the profile is automatically hidden (returns 404)."
					},
					"response": []
				},
				{
					"name": "3.4 Update Profile Details Anytime (/profiles/me - Pure JSON)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"displayName\": \"Mohan Kumar (Updated)\",\n  \"bio\": \"Lead Full-Stack Engineer | Distributed Systems & Spring Cloud | Cloudinary Integrated\",\n  \"dateOfBirth\": \"2000-01-15\",\n  \"gender\": \"MALE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/profiles/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "profiles", "me"]
						},
						"description": "Updates username, displayName, bio, dateOfBirth, or gender anytime using pure JSON. Any existing avatar image URL is preserved."
					},
					"response": []
				},
				{
					"name": "3.5 Upload / Update Avatar Anytime (/profiles/avatar - File)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "avatar",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/profiles/avatar",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "profiles", "avatar"]
						},
						"description": "Uploads or replaces the user avatar anytime using binary File upload. Deletes the prior avatar from Cloudinary and updates profile_image_url in the database."
					},
					"response": []
				},
				{
					"name": "3.6 Delete Avatar Anytime (/profiles/avatar)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/profiles/avatar",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "profiles", "avatar"]
						},
						"description": "Deletes the avatar image from Cloudinary and resets profile_image_url to null."
					},
					"response": []
				}
			]
		}
	]
}
